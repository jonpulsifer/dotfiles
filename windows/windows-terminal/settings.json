{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",

    "//": "Every profile is listed here with its own GUID. Terminal records each profile it generates in state.json, and a generated profile missing from this file counts as one the user deleted, so a list left to the generators hides everything on a machine where Terminal ran before the deploy. The generators that would duplicate these profiles are off, and Windows PowerShell and cmd are listed so that Terminal never writes their stubs through the link into the checkout. Argonaut and CaskaydiaCove match the ghostty config the other platforms use.",

    "defaultProfile": "{7d937d22-dfa8-480a-8b30-22bf062f9b04}",

    "disabledProfileSources": [
        "Windows.Terminal.Azure",
        "Windows.Terminal.PowershellCore",
        "Windows.Terminal.SshConfig",
        "Windows.Terminal.VisualStudio",
        "Windows.Terminal.Wsl"
    ],

    "copyOnSelect": true,
    "copyFormatting": "none",
    "startingDirectory": null,
    "useAcrylicInTabRow": true,
    "theme": "dark",

    "profiles": {
        "defaults": {
            "colorScheme": "Argonaut",
            "font": {
                "face": "CaskaydiaCove Nerd Font",
                "size": 12
            },
            "opacity": 90,
            "useAcrylic": true,
            "padding": "8",
            "scrollbarState": "hidden",
            "historySize": 100000,
            "antialiasingMode": "grayscale",
            "cursorShape": "bar"
        },
        "list": [
            {
                "guid": "{7d937d22-dfa8-480a-8b30-22bf062f9b04}",
                "name": "PowerShell",
                "commandline": "pwsh.exe -NoLogo",
                "icon": "ms-appx:///ProfileIcons/pwsh.png",
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "//": "windows/Install-Wsl.ps1 imports this distro with its root disk at D:\\WSL\\NixOS\\ext4.vhdx. /home is D:\\WSL\\home.vhdx, which the distro attaches itself at boot.",
                "guid": "{6f58f45b-da63-4a68-8c58-a9a55c48b10d}",
                "name": "NixOS",
                "commandline": "wsl.exe -d NixOS --cd ~"
            },
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "Windows PowerShell"
            },
            {
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "name": "Command Prompt"
            }
        ]
    },

    "schemes": [
        {
            "name": "Argonaut",
            "background": "#0E1019",
            "foreground": "#FFFAF4",
            "cursorColor": "#FF0018",
            "selectionBackground": "#002A3B",
            "black": "#232323",
            "red": "#FF000F",
            "green": "#8CE10B",
            "yellow": "#FFB900",
            "blue": "#008DF8",
            "purple": "#6D43A6",
            "cyan": "#00D8EB",
            "white": "#FFFFFF",
            "brightBlack": "#444444",
            "brightRed": "#FF2740",
            "brightGreen": "#ABE15B",
            "brightYellow": "#FFD242",
            "brightBlue": "#0092FF",
            "brightPurple": "#9A5FEB",
            "brightCyan": "#67FFF0",
            "brightWhite": "#FFFFFF"
        }
    ],

    "actions": [
        { "command": { "action": "splitPane", "split": "right", "splitMode": "duplicate" }, "keys": "alt+shift+plus" },
        { "command": { "action": "splitPane", "split": "down", "splitMode": "duplicate" }, "keys": "alt+shift+-" },
        { "command": { "action": "copy", "singleLine": false }, "keys": "ctrl+shift+c" },
        { "command": "paste", "keys": "ctrl+shift+v" },
        { "command": "find", "keys": "ctrl+shift+f" },
        { "command": { "action": "moveFocus", "direction": "left" }, "keys": "alt+left" },
        { "command": { "action": "moveFocus", "direction": "right" }, "keys": "alt+right" },
        { "command": { "action": "moveFocus", "direction": "up" }, "keys": "alt+up" },
        { "command": { "action": "moveFocus", "direction": "down" }, "keys": "alt+down" }
    ]
}
